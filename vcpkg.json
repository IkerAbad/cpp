{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "rts",
  "version-semver": "0.0.1",
  "builtin-baseline": "dc1232a6e05dcc49703091e83743e3b4df9b9b7c",
  "dependencies": [
    "sdl3",
    {
      "name": "dbus",
      "$comment": "Solo el manifiesto raíz puede desactivar la feature por defecto 'systemd' de dbus (la pide sdl3[ibus]); sin esto se arrastran libsystemd, meson, python y autotools.",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "imgui",
      "features": [ "sdl3-binding", "sdlgpu3-binding" ]
    },
    "entt",
    "spdlog",
    "tomlplusplus",
    "doctest"
  ],
  "features": {
    "tracy": {
      "description": "Perfilado con Tracy",
      "dependencies": [ "tracy" ]
    }
  }
}
